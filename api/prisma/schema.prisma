// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  name        String
  password    String?
  googleid    String?
  phoneNumber String? @unique
  shops       Shop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Owner {
  id          String  @id @default(uuid())
  email       String  @unique
  name        String
  password    String?
  googleid    String?
  phoneNumber String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
  admins    Admin[]
}

model Admin {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String
  password String?

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  shopAdminAccesses shopAdminAccess[]
}

model shopAdminAccess {
  id String @id @default(uuid())

  adminId String
  shopId  String

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Token {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiredAt DateTime
}

model Shop {
  id String @id @default(uuid())

  userId String

  shopName   String
  ownerId    String?
  platformId String?

  sales             Sale[]
  products          Product[]
  shopAdminAccesses shopAdminAccess[]

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner    Owner?    @relation(fields: [ownerId], references: [id])
  platform Platform? @relation(fields: [platformId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Product {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productName String

  hasVariant Boolean   @default(false) // in case product didnt have variant
  variants   Variant[]

  productStock        Int
  productCostPrice    Float? // optional because cost price is a private matter 
  productSellingPrice Float

  promoPrice     Float?
  promoStartDate DateTime?
  promoEndDate   DateTime?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

model Variant {
  id String @id @default(uuid())

  variantName  String
  stock        Int    @default(0)
  costPrice    Float? // optional because cost price is a private matter
  sellingPrice Float

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  promoPrice     Float?
  promoStartDate DateTime?
  promoEndDate   DateTime?

  sale Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Platform {
  id         String @id @default(uuid())
  name       String @unique
  feePercent Float  @default(0)
  fixedFee   Float  @default(0)
  shops      Shop[]
}

model Sale {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity       Int
  totalPrice     Float
  totalCost      Float?
  profit         Float?
  platformFee    Float?
  netProfit      Float?
  status         Status @default(SOLD)
  discountAmount Float  @default(0)

  resi     String?
  saleDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  returs    Retur[]

  @@index([shopId])
  @@index([productId])
  @@index([saleDate])
}

model Retur {
  id               String   @id @default(uuid())
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  quantityReturned Int      @default(1)
  returnResi       String
  type             Status // RETURN (Back to stock) or LOSS (Brick/Trash)
  reason           String
  evidenceUrl      String
  createdAt        DateTime @default(now())
}

enum Status {
  SOLD
  RETURN
  LOSS
}
